export const searchReducer = createReducer(initialState, builder => {
  builder
    .addCase(setNdgSearchInfo, (state, action) => {
      state.searchInfo = { ...initialState.searchInfo, ndg: action.payload };
    })
    .addCase(setGorSearchInfo, (state, action) => {
      state.searchInfo = { ...initialState.searchInfo, gorNdg: action.payload };
    })
    .addCase(setAccountSearchInfo, (state, action) => {
      state.searchInfo = { ...initialState.searchInfo, accountNumber: action.payload };
    })
    .addCase(getSuggestionTransID.pending, state => {
      state.suggestion = initialState.suggestion;
    })
    .addCase(getSuggestionTransID.fulfilled, (state, action) => {
      state.suggestion.transID = action.payload;
    })
  ......
});




