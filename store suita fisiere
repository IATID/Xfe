export const getSuggestionNdg = createAsyncThunk<RestResponseDtoListSuggestionDTO, string, any>(
  'search/getSuggestionNdg',
  async (ndg, { rejectWithValue, getState, dispatch }) => {
    try {
      //const search = getState().search;
      dispatch(showLoader(TypeLoader.NDG));
      const value = ndg.length >= 8 ? ndg.replace(/^0+/, '') : ndg.padStart(4, '0');
      const request: GetSuggestionRequest = {
        value,
        entity: TransactionEnums.Ndg,
      };
      return new SearchApi(getConfiguration(Configuration, getState))
        .getSuggestion(request)
        .then((result: RestResponseDtoListSuggestionDTO) => {
          dispatch(hideLoader(TypeLoader.NDG));
          return result || '';
        })
        .catch((error: unknown) => {
          dispatch(hideLoader(TypeLoader.NDG));
          return rejectWithValue(error);
        });
    } catch (error: unknown) {
      dispatch(hideLoader(TypeLoader.NDG));
      return rejectWithValue(error);
    }
  }
);
