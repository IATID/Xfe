export const setNdgSearchInfo = createAction<string, 'search/setNdgSearchInfo'>('search/setNdgSearchInfo');
export const setGorSearchInfo = createAction<string, 'search/setGorSearchInfo'>('search/setGorSearchInfo');
export const setAccountSearchInfo = createAction<string, 'search/setAccountSearchInfo'>('search/setAccountSearchInfo');
//thunk
export const getSuggestionTransID = createAsyncThunk<RestResponseDtoListSuggestionDTO, string, any>(
  'search/getSuggestionTransID',
  async (transID, { rejectWithValue, getState, dispatch }) => {
    try {
      //const search = getState().search;
      dispatch(showLoader(TypeLoader.TRANS_ID));
      const request: GetSuggestionRequest = {
        value: transID,
        entity: TransactionEnums.TransactionId,
      };
      return new SearchApi(getConfiguration(Configuration, getState))
        .getSuggestion(request)
        .then((result: RestResponseDtoListSuggestionDTO) => {
          dispatch(hideLoader(TypeLoader.TRANS_ID));
          return result || '';
        })
        .catch((error: unknown) => {
          dispatch(hideLoader(TypeLoader.TRANS_ID));
          return rejectWithValue(error);
        });
    } catch (error: unknown) {
      dispatch(hideLoader(TypeLoader.TRANS_ID));
      return rejectWithValue(error);
    }
  }
);
